# Generated by varsha from etc/templates/httpd.conf.j2 - edit the template, not this file.
# Regenerated on every Apache start.

ServerRoot "{{ home }}"
# Loopback only: the site isn't reachable from the network unless you share it on purpose.
Listen 127.0.0.1:{{ port }}
Listen [::1]:{{ port }}
{% if https_port %}
# 443 is always opened, so the port check and "running" state don't depend on mkcert;
# without certificates it only serves the default site over plain HTTP.
Listen 127.0.0.1:{{ https_port }}
Listen [::1]:{{ https_port }}
{% endif %}
ServerName localhost:{{ port }}
ServerAdmin admin@localhost

{% for module in modules -%}
LoadModule {{ module.name }} "{{ module.path }}"
{% endfor %}
# Windows gotchas: AcceptEx and TransmitFile break behind some antivirus / VPN filter drivers
# (requests hang or truncate), so use plain accept() and normal reads.
AcceptFilter http none
AcceptFilter https none
EnableSendfile off
EnableMMAP off

ThreadsPerChild 150
Timeout 300
KeepAlive On
PidFile "{{ data }}/apache/httpd.pid"

ErrorLog "{{ logs }}/apache-error.log"
LogLevel warn
LogFormat "%h %l %u %t \"%r\" %>s %b \"%{Referer}i\" \"%{User-Agent}i\"" combined
CustomLog "{{ logs }}/apache-access.log" combined

TypesConfig conf/mime.types
AddType application/x-x509-ca-cert .crt
AddType application/x-pkcs7-crl .crl
DirectoryIndex index.php index.html index.htm

<Directory />
    AllowOverride None
    Require all denied
</Directory>

<Files ".ht*">
    Require all denied
</Files>

DocumentRoot "{{ www }}"
<Directory "{{ www }}">
    Options Indexes FollowSymLinks ExecCGI
    AllowOverride All
    Require all granted
</Directory>

{% if php %}
# ---- PHP {{ php.label }} through mod_fcgid (php-cgi.exe runs as separate processes) ----
<IfModule fcgid_module>
    # mod_fcgid starts php-cgi with an almost empty environment. Without SystemRoot, PHP's
    # random_bytes()/openssl/curl fail on Windows ("Could not gather sufficient random data").
    FcgidInitialEnv SystemRoot "{{ system_root }}"
    FcgidInitialEnv windir "{{ system_root }}"
    FcgidInitialEnv PATH "{{ php.folder }};{{ system_root }}/system32;{{ system_root }}"
    FcgidInitialEnv TEMP "{{ data }}/tmp"
    FcgidInitialEnv TMP "{{ data }}/tmp"
    FcgidInitialEnv PHPRC "{{ php.ini_dir }}"
    # php-cgi never exits by itself; mod_fcgid recycles a process after 500 requests.
    FcgidInitialEnv PHP_FCGI_MAX_REQUESTS 0
    FcgidMaxRequestsPerProcess 500
    FcgidMaxProcesses 20
    FcgidIOTimeout 3600
    FcgidConnectTimeout 20
    # The default (128 KB) makes every larger upload or phpMyAdmin import fail with a 500.
    FcgidMaxRequestLen 268435456

    <FilesMatch "\.php$">
        AddHandler fcgid-script .php
        FcgidWrapper "{{ php.cgi }}" .php
    </FilesMatch>
</IfModule>
{% else %}
# No PHP build with php-cgi.exe was found in bin/php - .php files are served as plain text.
{% endif %}

{% if phpmyadmin %}
# ---- phpMyAdmin ----
Alias /phpmyadmin "{{ phpmyadmin }}"
<Directory "{{ phpmyadmin }}">
    Options FollowSymLinks ExecCGI
    AllowOverride None
    Require local
    # A Cloudflare tunnel connects from 127.0.0.1, so "Require local" alone would let anyone
    # with a shared link reach phpMyAdmin. Tunnel requests carry CF-Connecting-IP: refuse them.
    <If "-n req('CF-Connecting-IP')">
        Require all denied
    </If>
</Directory>
{% endif %}

# ---- HTTPS (certificates from mkcert, trusted once via "Trust HTTPS" in varsha) ----
<IfModule ssl_module>
    SSLRandomSeed startup builtin
    SSLRandomSeed connect builtin
    SSLSessionCache "shmcb:{{ data }}/apache/ssl_scache(512000)"
    SSLProtocol all -SSLv3 -TLSv1 -TLSv1.1
</IfModule>

# ---- Default site: http://localhost (the first vhost on a port is used for unknown names,
# so it must come before the per-site ones) ----
<VirtualHost *:{{ port }}>
    ServerName localhost
    DocumentRoot "{{ www }}"
</VirtualHost>
{% if https_port and localhost_cert %}
<VirtualHost *:{{ https_port }}>
    ServerName localhost
    DocumentRoot "{{ www }}"
    SSLEngine on
    SSLCertificateFile "{{ localhost_cert.cert }}"
    SSLCertificateKeyFile "{{ localhost_cert.key }}"
</VirtualHost>
{% endif %}

# ---- One file per folder in www/: <name>.{{ tld }} ----
IncludeOptional "{{ etc }}/apache/sites-enabled/*.conf"
