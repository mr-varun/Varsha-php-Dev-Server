; Generated by varsha from etc/templates/php.ini.j2 for PHP {{ php.label }} - edit the template, not this file.
; Folder: {{ php.folder }}

[PHP]
engine = On
short_open_tag = {{ "On" if php.major < 7 else "Off" }}
memory_limit = 512M
max_execution_time = 300
max_input_time = 300
max_input_vars = 5000
post_max_size = 256M
upload_max_filesize = 256M
max_file_uploads = 50
file_uploads = On
upload_tmp_dir = "{{ data }}/tmp"
{% if php.major >= 7 or (php.major == 5 and php.minor >= 5) %}
sys_temp_dir = "{{ data }}/tmp"
{% endif %}

; Development settings: show everything.
error_reporting = E_ALL
display_errors = On
display_startup_errors = On
log_errors = On
error_log = "{{ logs }}/php-{{ php.version }}.log"
html_errors = On

default_charset = "UTF-8"
output_buffering = 4096
realpath_cache_size = 4096k
allow_url_fopen = On

extension_dir = "{{ php.extension_dir }}"
{% for ext in extensions %}
extension={{ ext }}
{% endfor %}
{% for ext in zend_extensions %}
zend_extension={{ ext }}
{% endfor %}

[Date]
date.timezone = "{{ timezone }}"

[mail function]
; Mail goes to Mailpit - open its inbox from varsha.
SMTP = 127.0.0.1
smtp_port = {{ smtp_port }}
sendmail_from = "varsha@localhost"

[Session]
session.save_path = "{{ data }}/tmp/sessions"
; phpMyAdmin keeps you logged in for 8 hours; sessions must last at least that long.
session.gc_maxlifetime = 28800

[curl]
curl.cainfo = "{{ cacert }}"

[openssl]
openssl.cafile = "{{ cacert }}"
{% if overrides %}

; ---- Your settings (varsha panel -> System -> PHP -> Configure). Later lines win. ----
[PHP]
{% for key, value in overrides.items() %}
{{ key }} = {{ value }}
{% endfor %}
{% endif %}
