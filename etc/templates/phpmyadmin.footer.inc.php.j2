<?php
/*
 * Generated by varsha from etc/templates/phpmyadmin.footer.inc.php.j2.
 * phpMyAdmin includes this file at the bottom of every page (including the login page).
 * On the login page it adds a "Quick login" panel: one row per database server with a live
 * running/stopped dot, a "Use" button (fills server + user root) and a one-click "Log in"
 * for servers that still have no root password.
 */
$varshaServers = {{ servers_php }};
foreach ($varshaServers as &$s) {
    if ($s['remote']) {
        $s['up'] = true; // not probed: a remote host can take seconds to answer on every page
        continue;
    }
    $fp = @fsockopen($s['host'], (int) $s['port'], $errno, $errstr, 0.3);
    $s['up'] = (bool) $fp;
    if ($fp) {
        fclose($fp);
    }
}
unset($s);
?>
