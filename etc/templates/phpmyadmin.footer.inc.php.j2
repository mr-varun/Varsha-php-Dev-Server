<script>
(function () {
  var form = document.getElementById('login_form');
  var tpl = document.getElementById('vx-tpl');
  if (!form || !tpl || document.body.id !== 'loginform') { return; }   // not the login page

  document.documentElement.classList.add('vx');
  document.body.insertBefore(tpl.content.cloneNode(true), document.body.firstChild);
  var shell = document.querySelector('.vx-shell');
  var main = shell.querySelector('.vx-main');

  // Move phpMyAdmin's real pieces into the new layout (listeners and tokens stay intact).
  var content = document.getElementById('page_content');
  content.querySelectorAll('.alert').forEach(function (alert) {
    if (!alert.closest('.hide') && !alert.closest('noscript')) { main.querySelector('.vx-alerts').appendChild(alert); }
  });
  main.querySelector('.vx-form').appendChild(form);
  form.classList.remove('hide');
  var langSelect = document.getElementById('languageSelect');
  if (langSelect) {
    var langCard = langSelect.closest('.js-show') || langSelect.closest('.card');
    langCard.classList.remove('hide');
    var langBox = main.querySelector('.vx-lang');
    langBox.appendChild(document.createTextNode('Language'));
    langBox.appendChild(langCard);
  }

  var user = document.getElementById('input_username');
  var pass = document.getElementById('input_password');
  var select = document.getElementById('select_server');
  if (select && select.closest('.row')) { select.closest('.row').classList.add('vx-hidden'); }

  var body = form.querySelector('.card-body') || form;
  var title = document.createElement('p');
  title.className = 'vx-form-title';
  title.textContent = 'Or sign in with a user';
  var target = document.createElement('p');
  target.className = 'vx-target';
  body.insertBefore(target, body.firstChild);
  body.insertBefore(title, target);
  if (user && !user.value) { user.value = 'root'; }

  var tiles = shell.querySelectorAll('.vx-srv');
  function pick(tile, focusUser) {
    tiles.forEach(function (t) { t.classList.remove('picked'); });
    tile.classList.add('picked');
    if (select) { select.value = tile.getAttribute('data-server'); }
    target.innerHTML = '';
    target.appendChild(document.createTextNode('Server: '));
    var b = document.createElement('b');
    b.textContent = tile.getAttribute('data-name');
    target.appendChild(b);
    if (tile.getAttribute('data-kind') === 'local') {
      if (user) { user.value = 'root'; }
    } else if (focusUser && user) {
      user.value = '';
      user.focus();
    }
  }
  var current = select && shell.querySelector('.vx-srv[data-server="' + select.value + '"]');
  pick(current || tiles[0]);

  shell.querySelector('.vx-groups').addEventListener('click', function (event) {
    var tile = event.target.closest('.vx-srv');
    if (!tile || event.target.closest('a')) { return; }
    var action = event.target.closest('[data-vx]');
    if (tile.classList.contains('down')) { return; }
    pick(tile, !!action);
    if (action && action.getAttribute('data-vx') === 'login') {
      if (pass) { pass.value = ''; }
      var go = document.getElementById('input_go');
      if (go) { go.click(); } else { form.submit(); }
    } else if (!action && pass && tile.getAttribute('data-kind') === 'local') {
      pass.focus();
    }
  });
})();
</script>
