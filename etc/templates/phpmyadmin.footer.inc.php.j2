 * database server (live running/stopped dot, one-click root login for local servers, "Open" for
 * remote servers with a saved password) and phpMyAdmin's own login form restyled below them.
 * The real form (token, session, server select) is moved, never rebuilt, so phpMyAdmin's login
 * handling is unchanged. phpMyAdmin's CSP allows inline style/script ('unsafe-inline').
 */
$varshaServers = {{ servers_php }};
foreach ($varshaServers as &$s) {
    if ($s['remote']) {
        $s['up'] = true; // not probed: a remote host can take seconds to answer on every page
        continue;
    }
    $fp = @fsockopen($s['host'], (int) $s['port'], $errno, $errstr, 0.3);
    $s['up'] = (bool) $fp;
    if ($fp) {
        fclose($fp);
    }
}
unset($s);
