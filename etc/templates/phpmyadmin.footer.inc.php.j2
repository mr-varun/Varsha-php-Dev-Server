       Remote servers with a saved password open directly; add them in varsha &rarr; Databases.</p>
    <table>
      <?php foreach ($varshaServers as $s): ?>
      <tr data-server="<?= (int) $s['index'] ?>">
        <td><span class="dot <?= $s['up'] ? 'up' : 'down' ?>"></span><?= htmlspecialchars($s['name']) ?></td>
        <td class="port">:<?= (int) $s['port'] ?></td>
        <td class="state"><?= $s['remote'] ? 'remote' : ($s['up'] ? 'running' : 'not running') ?></td>
        <td style="text-align:right; white-space:nowrap">
          <?php if ($s['remote'] && $s['auto']): ?>
          <a class="btn btn-sm btn-primary" href="index.php?server=<?= (int) $s['index'] ?>" title="Saved password: logs in directly">Open</a>
          <?php elseif ($s['remote']): ?>
          <button type="button" class="btn btn-sm btn-outline-secondary" data-varsha="use-remote">Use</button>
          <?php else: ?>
          <button type="button" class="btn btn-sm btn-outline-secondary" data-varsha="use" <?= $s['up'] ? '' : 'disabled' ?>>Use</button>
          <button type="button" class="btn btn-sm btn-primary" data-varsha="login" <?= $s['up'] ? '' : 'disabled' ?>
                  title="Log in as root with an empty password">Log in</button>
          <?php endif; ?>
        </td>
      </tr>
      <?php endforeach; ?>
    </table>
  </div>
</div>
<script>
(function () {
  var form = document.getElementById('login_form');
  var holder = document.getElementById('varsha-quick-login');
  if (!form || !holder) { return; }          // not the login page
  var body = form.querySelector('.card-body') || form;
  body.insertBefore(holder, body.firstChild);
  holder.hidden = false;

  var user = document.getElementById('input_username');
  var pass = document.getElementById('input_password');
  var select = document.getElementById('select_server');
  if (user && !user.value) { user.value = 'root'; }

  function pick(row, keepUser) {
    holder.querySelectorAll('tr').forEach(function (r) { r.classList.remove('picked'); });
    row.classList.add('picked');
    if (select) { select.value = row.getAttribute('data-server'); }
    if (user && !keepUser) { user.value = 'root'; }
  }
  if (select) {
    var current = holder.querySelector('tr[data-server="' + select.value + '"]');
    if (current) { current.classList.add('picked'); }
  }
  holder.addEventListener('click', function (event) {
    var button = event.target.closest('button[data-varsha]');
    if (!button) { return; }
    var row = button.closest('tr');
    var kind = button.getAttribute('data-varsha');
    pick(row, kind === 'use-remote');
    if (kind === 'use-remote') {
      if (user) { user.value = ''; user.focus(); }
      return;
    }
    if (button.getAttribute('data-varsha') === 'login') {
      if (pass) { pass.value = ''; }
      var go = document.getElementById('input_go');
      if (go) { go.click(); } else { form.submit(); }
    } else if (pass) {
      pass.focus();
    }
  });
})();
</script>
