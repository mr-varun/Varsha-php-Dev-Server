<?php
/*
 * Generated by varsha from etc/templates/phpmyadmin.config.inc.php.j2 - edit the template,
 * not this file. Regenerated on every Apache start; servers come from config/services.json
 * (databases) and settings.json "phpmyadmin_extra_servers".
 */
declare(strict_types=1);

$cfg['blowfish_secret'] = '{{ blowfish_secret }}';

// Saved passwords of remote servers with auto-login (a separate, user-only file).
$varshaSecrets = is_file({{ secrets_file | php_str }}) ? (include {{ secrets_file | php_str }}) : [];

{% for server in servers %}
/* {{ loop.index }}: {{ server.name }} */
$cfg['Servers'][{{ loop.index }}]['verbose'] = {{ server.label | php_str }};
$cfg['Servers'][{{ loop.index }}]['host'] = {{ server.host | php_str }};
$cfg['Servers'][{{ loop.index }}]['port'] = '{{ server.port }}';
$cfg['Servers'][{{ loop.index }}]['connect_type'] = 'tcp';
$cfg['Servers'][{{ loop.index }}]['compress'] = false;
$cfg['Servers'][{{ loop.index }}]['hide_db'] = '^(information_schema|performance_schema|sys)$';
{% if server.is_remote %}
// Remote server ({{ server.host }}): managed from varsha's Databases tab.
{% if server.auto_login %}
$cfg['Servers'][{{ loop.index }}]['auth_type'] = 'config';
$cfg['Servers'][{{ loop.index }}]['user'] = {{ server.user | php_str }};
$cfg['Servers'][{{ loop.index }}]['password'] = $varshaSecrets[{{ server.remote_id | php_str }}] ?? '';
{% else %}
$cfg['Servers'][{{ loop.index }}]['auth_type'] = 'cookie';
{% endif %}
{% if server.ssl %}
$cfg['Servers'][{{ loop.index }}]['ssl'] = true;
$cfg['Servers'][{{ loop.index }}]['ssl_verify'] = {{ "true" if server.ssl_verify else "false" }};
{% if server.ssl_ca %}
$cfg['Servers'][{{ loop.index }}]['ssl_ca'] = {{ server.ssl_ca | php_str }};
{% endif %}
{% endif %}
{% else %}
$cfg['Servers'][{{ loop.index }}]['auth_type'] = 'cookie';
// Fresh varsha databases have a root user without a password.
$cfg['Servers'][{{ loop.index }}]['AllowNoPassword'] = true;
{% endif %}

{% endfor %}
$cfg['ServerDefault'] = 1;

// Easier logins: remember the last user and server, and stay logged in for 8 hours.
$cfg['LoginCookieRecall'] = true;
$cfg['LoginCookieValidity'] = 28800;
$cfg['LoginCookieStore'] = 0;
$cfg['AllowArbitraryServer'] = false;
// Show a server switcher in the navigation panel once logged in.
$cfg['NavigationDisplayServers'] = true;
$cfg['DisplayServersList'] = false;

$cfg['TempDir'] = {{ temp_dir | php_str }};
$cfg['UploadDir'] = '';
$cfg['SaveDir'] = '';
$cfg['ExecTimeLimit'] = 600;
$cfg['MaxNavigationItems'] = 250;

// A local tool: no phone-home.
$cfg['VersionCheck'] = false;
$cfg['SendErrorReports'] = 'never';
