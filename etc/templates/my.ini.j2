# Generated by varsha from etc/templates/my.ini.j2 for {{ name }} - edit the template, not this file.

[client]
port = {{ port }}
host = 127.0.0.1
default-character-set = utf8mb4

[mysqld]
port = {{ port }}
# Loopback only, so the database isn't reachable from the network.
bind-address = 127.0.0.1
basedir = "{{ home }}"
datadir = "{{ data_dir }}"
# A unique pipe/socket name and pid file per instance, so several versions can run side by side.
socket = "varsha-{{ id }}"
pid-file = "{{ data_dir }}/{{ id }}.pid"
tmpdir = "{{ data }}/tmp"

character-set-server = utf8mb4
collation-server = utf8mb4_unicode_ci
max_allowed_packet = 256M
max_connections = 200
innodb_buffer_pool_size = 256M
innodb_file_per_table = 1
{% if is_mariadb %}
# MariaDB {{ version }}
{% elif major == 5 and minor == 6 %}
# MySQL 5.6: silence the TIMESTAMP deprecation warning on every start.
explicit_defaults_for_timestamp = 1
sql_mode = NO_ENGINE_SUBSTITUTION,STRICT_TRANS_TABLES
{% elif major == 5 %}
explicit_defaults_for_timestamp = 1
{% elif major >= 8 %}
# MySQL {{ version }}: keep the old auth plugin loadable for legacy apps (PHP < 7.4 can't use
# caching_sha2_password). New users still default to caching_sha2_password.
{% if major > 8 or minor >= 4 %}
mysql_native_password = ON
{% endif %}
{% endif %}

[mysqldump]
max_allowed_packet = 256M
